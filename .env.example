# Environment variables
#
# Copy to `.env` for local development, or set these in the hosting provider's
# build environment. Only `SITE_URL` affects the output; the other two are
# optional and change what the site renders.

# Required. The public origin, with no trailing slash.
# Every canonical URL, sitemap entry, hreflang tag and robots.txt line is
# derived from this at build time. Change it and rebuild to move domains.
SITE_URL=https://example.com

# Optional. Google AdSense publisher id, e.g. ca-pub-0000000000000000.
# When empty, no ad script is loaded AND the privacy policy states that no
# advertising service is in use. Setting this also switches on the consent
# banner and the ads.txt route.
ADSENSE_CLIENT=

# Optional. Cloudflare Web Analytics token.
# Cloudflare's analytics is cookieless and does not require a consent banner.
# When empty, the privacy policy states that no analytics is in use.
CF_ANALYTICS_TOKEN=
