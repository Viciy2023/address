# Environment variables
#
# Copy to `.env` for local development, or set these in the hosting provider's
# build environment.
#
# On Cloudflare Pages you normally set NONE of these: Pages injects CF_PAGES_URL
# into every build, and the site reads it to build absolute URLs. Only set
# SITE_URL if you want to override that (for example, to force the canonical
# origin to a custom domain, or to build locally against a specific host).
# The two integrations below are optional and change what the site renders.

# The public origin, with no trailing slash.
#
# Resolution order at build time:
#   1. SITE_URL (this variable) — explicit override, wins if set
#   2. CF_PAGES_URL            — injected by Cloudflare Pages, used automatically
#   3. http://localhost:4321   — development default
#
# Every canonical URL, sitemap entry, hreflang tag and robots.txt line is
# derived from the resolved value at build time. Leave this unset on Pages.
# SITE_URL=https://example.com

# Optional. Google AdSense publisher id, e.g. ca-pub-0000000000000000.
# When empty, no ad script is loaded AND the privacy policy states that no
# advertising service is in use. Setting this also switches on the consent
# banner and the ads.txt route.
ADSENSE_CLIENT=

# Optional. Cloudflare Web Analytics token.
# Cloudflare's analytics is cookieless and does not require a consent banner.
# When empty, the privacy policy states that no analytics is in use.
CF_ANALYTICS_TOKEN=
