---
/**
 * Base layout: head metadata, header, footer, theme toggle.
 *
 * Every URL in here is derived from `src/config.ts`, so the domain appears
 * exactly once in the codebase.
 */
import "../styles/global.css";
import { SITE, LANGS, LANG_LABEL, LANG_TAG, type SiteLang, localize, absolute } from "../config";
import { t } from "../i18n/strings";
import Integrations from "../components/Integrations.astro";
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
  lang: SiteLang;
  /** Path relative to the language root, e.g. "/about/" or "/". */
  path: string;
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
}

const { lang, path, title, description, jsonLd = [] } = Astro.props;
const s = t(lang);

const canonical = absolute(path, lang);

/** hreflang set: always absolute URLs, zh-CN plus x-default, no duplicates. */
const alternates = LANGS.map((l) => ({ hreflang: LANG_TAG[l], href: absolute(path, l) }));
const xDefault = { hreflang: "x-default", href: absolute(path, "zh") };

const ogImage = `${SITE.url}/og.png`;
---

<!doctype html>
<html lang={LANG_TAG[lang]} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang={xDefault.hreflang} href={xDefault.href} />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.product[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={LANG_TAG[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={LANG_TAG[l]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Third-party scripts, only when configured. -->
    <Integrations />

    <!-- Inter, self-hosted via Google Fonts with display=swap to avoid FOIT. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    <!-- Set the theme before first paint so there is no flash of the wrong mode. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{s.navGenerate}</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={localize("/", lang)}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-text">
            <strong>{SITE.product[lang]}</strong>
            <small>{SITE.name}</small>
          </span>
        </a>

        <nav class="nav" aria-label={s.navGenerate}>
          <a href={localize("/", lang)}>{s.navGenerate}</a>
          <a href={localize("/countries/", lang)}>{s.navCountries}</a>
          <a href={localize("/credits/", lang)}>{s.navCredits}</a>
        </nav>

        <div class="header-tools">
          <label class="sr-only" for="lang-select">{s.langLabel}</label>
          <select
            id="lang-select"
            class="select lang-select"
            data-current={lang}
            data-targets={JSON.stringify(Object.fromEntries(LANGS.map((l) => [l, localize(path, l)])))}
          >
            {LANGS.map((l) => (
              <option value={l} selected={l === lang}>{LANG_LABEL[l]}</option>
            ))}
          </select>

          <button class="btn btn-ghost theme-toggle" type="button" aria-label="Theme">
            <svg class="ico-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
            </svg>
            <svg class="ico-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <div class="footer-grid">
          <div>
            <p class="footer-brand">{SITE.product[lang]}</p>
            <p class="muted footer-desc">{s.footerNote}</p>
            <p class="faint footer-attr">
              <a href={localize("/credits/", lang)}>{s.linkCredits}</a>
            </p>
          </div>
          <nav aria-label={s.navGenerate}>
            <p class="eyebrow">{s.navGenerate}</p>
            <a href={localize("/", lang)}>{s.navGenerate}</a>
            <a href={localize("/countries/", lang)}>{s.linkCountries}</a>
            <a href={localize("/credits/", lang)}>{s.linkCredits}</a>
          </nav>
          <nav aria-label={s.linkAbout}>
            <p class="eyebrow">{s.linkAbout}</p>
            <a href={localize("/about/", lang)}>{s.linkAbout}</a>
            <a href={localize("/contact/", lang)}>{s.linkContact}</a>
            <a href={localize("/privacy/", lang)}>{s.linkPrivacy}</a>
            <a href={localize("/terms/", lang)}>{s.linkTerms}</a>
          </nav>
        </div>
        <div class="footer-bottom">
          <p class="faint">© {new Date().getFullYear()} {SITE.name}. {s.footerRights}</p>
        </div>
      </div>
    </footer>

    {SITE.adsenseClient && <ConsentBanner {lang} />}

    <script>
      // Language switcher: navigate to the same page in the chosen language.
      // Astro processes this as a module, so TypeScript is available and the
      // bundle is deduplicated across pages.
      const sel = document.getElementById("lang-select") as HTMLSelectElement | null;
      sel?.addEventListener("change", () => {
        const targets = JSON.parse(sel.dataset.targets ?? "{}") as Record<string, string>;
        const dest = targets[sel.value];
        if (dest) window.location.href = dest;
      });

      // Theme toggle, persisted.
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", dark ? "dark" : "light");
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 62px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    /* The header is 62px tall; make the whole height clickable rather than
       just the 30px the logo and text occupy. */
    min-height: 44px;
    padding-block: 0.5rem;
  }

  .brand-mark {
    width: 26px;
    height: 26px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-text strong {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand-text small {
    font-size: 0.6875rem;
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }

  /* The product name is long in some languages; hide it on small screens. */
  @media (max-width: 560px) {
    .brand-text strong { display: none; }
  }

  .nav {
    display: none;
    gap: 1.5rem;
    margin-inline-start: auto;
  }

  .nav a {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 160ms ease;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0;
  }
  .nav a:hover { color: var(--text); }

  @media (min-width: 860px) {
    .nav { display: flex; }
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-start: auto;
  }

  @media (min-width: 860px) {
    .header-tools { margin-inline-start: 0.5rem; }
  }

  .lang-select {
    width: auto;
    min-width: 6.5rem;
    padding-block: 0.375rem;
    padding-inline: 0.5rem 1.75rem;
    font-size: 0.8125rem;
    min-height: 38px;
    background-position: right 0.5rem center;
  }

  .theme-toggle {
    padding: 0.5rem;
    min-height: 44px;
    min-width: 44px;
    color: var(--text-muted);
  }

  .theme-toggle .ico-moon { display: none; }
  :global(.dark) .theme-toggle .ico-sun { display: none; }
  :global(.dark) .theme-toggle .ico-moon { display: block; }

  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--border);
    padding-block: 3rem 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 720px) {
    .footer-grid { grid-template-columns: 2fr 1fr 1fr; }
  }

  .footer-brand {
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 0.375rem;
  }

  .footer-desc {
    font-size: 0.8125rem;
    margin: 0 0 0.75rem;
    max-width: 34ch;
  }

  .footer-attr { font-size: 0.8125rem; margin: 0; }
  .footer-attr a {
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0;
  }
  .footer-attr a:hover { text-decoration: underline; }

  .footer-grid nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-grid nav a {
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0;
  }

  .footer-grid nav a:hover { color: var(--text); }

  .footer-bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
  }
  .footer-bottom p { margin: 0; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
