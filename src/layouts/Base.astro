---
/**
 * Base layout: head metadata, header, footer, theme toggle.
 *
 * Every URL in here is derived from `src/config.ts`, so the domain appears
 * exactly once in the codebase.
 */
import "../styles/global.css";
import { SITE, IS_PREVIEW, LANGS, LANG_LABEL, LANG_TAG, type SiteLang, localize, absolute } from "../config";
import { t } from "../i18n/strings";
import Integrations from "../components/Integrations.astro";
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
  lang: SiteLang;
  /** Path relative to the language root, e.g. "/about/" or "/". */
  path: string;
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
}

const { lang, path, title, description, jsonLd = [] } = Astro.props;
/** The home page is the only route whose path is "/". */
const isHome = path === "/";
const s = t(lang);

const canonical = absolute(path, lang);

/** hreflang set: always absolute URLs, zh-CN plus x-default, no duplicates. */
const alternates = LANGS.map((l) => ({ hreflang: LANG_TAG[l], href: absolute(path, l) }));
const xDefault = { hreflang: "x-default", href: absolute(path, "zh") };

const ogImage = `${SITE.url}/og.png`;
---

<!doctype html>
<html lang={LANG_TAG[lang]} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang={xDefault.hreflang} href={xDefault.href} />

    <meta name="robots" content={IS_PREVIEW ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.product[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={LANG_TAG[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={LANG_TAG[l]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Third-party scripts, only when configured. -->
    <Integrations />

    <!-- Inter, self-hosted via Google Fonts with display=swap to avoid FOIT. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    <!-- Set the theme before first paint so there is no flash of the wrong mode. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{s.navGenerate}</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={localize("/", lang)}>
          <span class="brand-mark" aria-hidden="true">
            <!-- Inline glyph so the mark needs no request and scales cleanly. -->
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
          </span>
          <span class="brand-text">
            <strong>{SITE.product[lang]}</strong>
            <small>{SITE.name[lang]}</small>
          </span>
        </a>

        <nav class="nav" aria-label={s.navGenerate}>
          <a class="nav-link" href={localize("/", lang)} aria-current={isHome ? "page" : undefined}>
            {s.navGenerate}
          </a>
          <a class="nav-link" href={localize("/countries/", lang)}>{s.navCountries}</a>
          <a class="nav-link" href={localize("/credits/", lang)}>{s.navCredits}</a>
        </nav>

        <div class="header-tools">
          <label class="sr-only" for="lang-select">{s.langLabel}</label>
          <select
            id="lang-select"
            class="select lang-select"
            data-current={lang}
            data-targets={JSON.stringify(Object.fromEntries(LANGS.map((l) => [l, localize(path, l)])))}
          >
            {LANGS.map((l) => (
              <option value={l} selected={l === lang}>{LANG_LABEL[l]}</option>
            ))}
          </select>

          <button class="btn btn-ghost theme-toggle" type="button" aria-label="Theme">
            <svg class="ico-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
            </svg>
            <svg class="ico-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <!--
          Footer layout:
            row 1  copyright · synthetic-data notice, and the navigation links
                   inline on the same line (wrapping only when there is no room)
            row 2  the Telegram mark, pinned bottom-right
        -->
        <div class="footer-legal-row">
          <p class="footer-legal faint">
            © {new Date().getFullYear()} {SITE.name[lang]}. {s.footerRights} · {s.footerNote}
          </p>
          <nav class="footer-links" aria-label={s.linkAbout}>
            <a href={localize("/", lang)}>{s.navGenerate}</a>
            <a href={localize("/countries/", lang)}>{s.linkCountries}</a>
            <a href={localize("/credits/", lang)}>{s.linkCredits}</a>
            <a href={localize("/about/", lang)}>{s.linkAbout}</a>
            <a href={localize("/contact/", lang)}>{s.linkContact}</a>
            <a href={localize("/privacy/", lang)}>{s.linkPrivacy}</a>
            <a href={localize("/terms/", lang)}>{s.linkTerms}</a>
          </nav>
        </div>

        <div class="footer-mark-row">
          <a
            class="contact-link"
            href={SITE.telegram}
            rel="noopener noreferrer"
            target="_blank"
            aria-label="Telegram"
          >
            <img src="/telegram.png" alt="Telegram" width="40" height="40" loading="lazy" decoding="async" />
          </a>
        </div>
      </div>
    </footer>

    {SITE.adsenseClient && <ConsentBanner {lang} />}

    <script>
      // Language switcher: navigate to the same page in the chosen language.
      // Astro processes this as a module, so TypeScript is available and the
      // bundle is deduplicated across pages.
      const sel = document.getElementById("lang-select") as HTMLSelectElement | null;
      sel?.addEventListener("change", () => {
        const targets = JSON.parse(sel.dataset.targets ?? "{}") as Record<string, string>;
        const dest = targets[sel.value];
        if (dest) window.location.href = dest;
      });

      // Theme toggle, persisted.
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", dark ? "dark" : "light");
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 62px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    /* The header is 62px tall; make the whole height clickable rather than
       just the 30px the logo and text occupy. */
    min-height: 44px;
    padding-block: 0.5rem;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    box-shadow: var(--shadow-xs);
  }

  /*
   * Brand: the product name and the company name sit on one line, separated by
   * a hairline dot. They were stacked, which read as two unrelated labels and
   * wrapped awkwardly in the longer languages (バーチャル・アイデンティティ).
   */
  .brand-text {
    display: flex;
    align-items: baseline;
    gap: 0.4375rem;
    line-height: 1.2;
    white-space: nowrap;
    min-width: 0;
  }

  .brand-text strong {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* Dot separator drawn in CSS so no extra element is needed. */
  .brand-text strong::after {
    content: "·";
    margin-inline-start: 0.4375rem;
    color: var(--border-strong);
    font-weight: 400;
  }

  .brand-text small {
    font-size: 0.75rem;
    color: var(--text-faint);
    letter-spacing: 0.02em;
  }

  /*
   * On narrow screens the company name is dropped rather than wrapping the
   * brand onto two lines; the product name alone still identifies the site.
   */
  @media (max-width: 560px) {
    .brand-text small,
    .brand-text strong::after { display: none; }
  }

  .nav {
    display: none;
    gap: 0.25rem;
    margin-inline-start: auto;
  }

  /*
   * Nav links are pills rather than bare text, so the current page can be shown
   * with a background instead of relying on colour alone.
   */
  .nav-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .nav-link[aria-current="page"] {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 500;
  }

  @media (min-width: 860px) {
    .nav { display: flex; }
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-inline-start: auto;
  }

  @media (min-width: 860px) {
    .header-tools { margin-inline-start: 0.75rem; }
  }

  .lang-select {
    width: auto;
    min-width: 6.5rem;
    min-height: 40px;
    padding-block: 0.375rem;
    padding-inline: 0.625rem 1.75rem;
    font-size: 0.8125rem;
    border-radius: var(--radius-sm);
    background-position: right 0.5rem center;
  }

  .theme-toggle {
    padding: 0.5rem;
    min-height: 40px;
    min-width: 40px;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
  }

  .theme-toggle .ico-moon { display: none; }
  :global(.dark) .theme-toggle .ico-sun { display: none; }
  :global(.dark) .theme-toggle .ico-moon { display: block; }

  /*
   * Footer.
   *
   * Row 1  copyright and the synthetic-data notice, with every navigation link
   *        inline on the same line. The links sit after the text and wrap as a
   *        group only when the viewport is too narrow to hold them.
   * Row 2  the Telegram mark, aligned to the right edge.
   *
   * The earlier three-column grid used roughly 300px of height for eight links
   * and one short sentence; this reads as a single strip.
   */
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    padding-block: 1.5rem 1.75rem;
  }

  .footer-legal-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
  }

  .footer-legal {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.125rem;
    /* Pushes the links to the right of the copyright text on wide screens. */
    margin-inline-start: auto;
  }

  .footer-links a {
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
    /* 44px minimum touch target without adding visual weight. */
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color 140ms ease;
  }

  .footer-links a:hover { color: var(--text); }

  /* Telegram mark, bottom-right. */
  .footer-mark-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.75rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px hit area around a 40px image. */
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-sm);
    transition: opacity 140ms ease;
  }

  .contact-link:hover { opacity: 0.8; }

  .contact-link img {
    display: block;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
